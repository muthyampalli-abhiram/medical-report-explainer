# Application Environment (development, production, testing)
APP_ENV=development

# Database path (local SQLite file - ignored by git)
DB_PATH=data/health.db

# LLM Provider selection: "gemini", "groq", or "fake"
LLM_PROVIDER=groq

# Confidential API Key (Never commit real API keys to version control)
# For Groq: Obtain key at https://console.groq.com/keys
# For Gemini: Obtain key at https://aistudio.google.com/app/apikey
LLM_API_KEY=your_api_key_here

# LLM Model selection
# Groq models: openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant
# Gemini models: gemini-2.0-flash, gemini-1.5-flash
LLM_MODEL=openai/gpt-oss-20b

# Reasoning effort (low, medium, high) - applicable for reasoning models
LLM_REASONING_EFFORT=low

# Maximum tokens generated by the LLM
LLM_MAX_TOKENS=4096

# Path to Tesseract OCR executable (adjust according to your OS)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
# macOS example: /opt/homebrew/bin/tesseract
TESSERACT_CMD=

# Maximum file upload size in megabytes
MAX_UPLOAD_MB=10

# OCR confidence thresholds
OCR_VERIFY_BELOW=0.85
OCR_UNKNOWN_BELOW=0.60
OCR_MAX_PAGES=5
OCR_MAX_IMAGE_PIXELS=40000000
